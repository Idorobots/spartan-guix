Preserve interface indices reported by an Avahi daemon in another network
namespace.  The public input conversion already accepts numeric indices, so
they can be passed back to that daemon without interpreting them locally.

--- a/src/utils.c
+++ b/src/utils.c
@@ -108,2 +108,5 @@ scm_from_avahi_interface_index (AvahiIfIndex c_interface)
   if (if_indextoname ((unsigned int) c_interface, c_name) == NULL)
-    scm_avahi_error (AVAHI_ERR_FAILURE, __FUNCTION__);
+    /* The daemon may live in a different network namespace, or the
+       interface may have disappeared since the event was queued.  Keep
+       its index so that clients can pass it back to the daemon.  */
+    return (scm_from_int ((int) c_interface));
