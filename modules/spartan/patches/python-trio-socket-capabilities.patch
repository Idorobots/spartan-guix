Probe socket capabilities before asserting optional kernel behaviour in tests.

Under ARM QEMU user emulation, SO_BINDTODEVICE with a NULL pointer and zero
length returns EFAULT, and IP_BIND_ADDRESS_NO_PORT getsockopt returns
ENOPROTOOPT.  Match those capabilities with stdlib sockets before exercising
the corresponding assertion.  Keep all test cases and the remaining socket
checks enabled; no Trio runtime code is changed.

--- a/src/trio/_tests/test_socket.py
+++ b/src/trio/_tests/test_socket.py
@@ -463,7 +463,17 @@
+def _supports_null_bindtodevice() -> bool:
+    # Some syscall translators reject a NULL optval even with optlen=0.
+    with stdlib_socket.socket() as probe:
+        try:
+            probe.setsockopt(stdlib_socket.SOL_SOCKET, stdlib_socket.SO_BINDTODEVICE, None, 0)
+        except OSError as exc:
+            return exc.errno != errno.EFAULT
+    return True
+
+
 def setsockopt_tests(sock: SocketType | SocketStream) -> None:
     """Extract these out, to be reused for SocketStream also."""
     # specifying optlen. Not supported on pypy, and I couldn't find
     # valid calls on darwin or win32.
-    if hasattr(tsocket, "SO_BINDTODEVICE"):
+    if hasattr(tsocket, "SO_BINDTODEVICE") and _supports_null_bindtodevice():
         try:
             sock.setsockopt(tsocket.SOL_SOCKET, tsocket.SO_BINDTODEVICE, None, 0)
